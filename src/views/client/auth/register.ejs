<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Register - LaptopShop</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #1cc88a, #4e73df);
            height: 100vh;
        }

        .register-container {
            height: 100vh;
        }

        .register-card {
            border-radius: 20px;
            overflow: hidden;
        }

        .register-left {
            background: linear-gradient(135deg, #1cc88a, #17a673);
            color: white;
            padding: 40px;
        }

        .register-left h2 {
            font-weight: 600;
        }

        .form-control {
            border-radius: 10px;
            padding: 12px;
        }

        .btn-register {
            border-radius: 10px;
            padding: 12px;
            font-weight: 500;
        }

        .register-right {
            padding: 40px;
        }
    </style>
</head>

<body>
    <div class="container register-container d-flex align-items-center justify-content-center">
        <div class="row shadow-lg register-card w-100" style="max-width: 1000px;">

            <!-- LEFT -->
            <div class="col-md-5 d-none d-md-flex flex-column justify-content-center register-left">
                <h2>Join LaptopShop 🚀</h2>
                <p class="mt-3">
                    Create an account to start shopping and managing your orders easily.
                </p>
            </div>

            <!-- RIGHT -->
            <div class="col-md-7 bg-white register-right">
                <h3 class="mb-4 text-center">Create Account</h3>

                <% errors.forEach((error)=> { %>
                    <div class="alert alert-danger">
                        <%= error %>
                    </div>
                <% }); %>

                <form method="post" action="/register">

                    <div class="mb-3">
                        <label class="form-label">Full name</label>
                        <input class="form-control" type="text" name="fullName"
                            value="<%= oldInput.fullName %>" placeholder="Enter your full name" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email address</label>
                        <input class="form-control" type="email" name="email"
                            value="<%= oldInput.email %>" placeholder="Enter your email" required />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Password</label>
                            <input class="form-control" type="password" name="password"
                                value="<%= oldInput.password %>" placeholder="Create password" required />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Confirm Password</label>
                            <input class="form-control" type="password" name="passwordConfirm"
                                value="<%= oldInput.passwordConfirm %>" placeholder="Confirm password" required />
                        </div>
                    </div>

                    <button class="btn btn-success w-100 btn-register">
                        Create Account
                    </button>
                </form>

                <div class="text-center mt-4">
                    <small>
                        Already have an account?
                        <a href="/login">Login</a>
                    </small>
                </div>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>