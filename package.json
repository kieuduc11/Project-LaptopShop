{
  "name": "project-laptopshop",
  "version": "1.0.0",
  "description": "LaptopShop MVC Application",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc && tsc-alias && copyfiles -u 1 \"src/views/**/*\" dist/views && copyfiles -u 1 \"public/**/*\" dist/public",
    "start": "set NODE_ENV=production&& node dist/app.js",
    "start:debug": "nodemon --inspect=9229 -e ts,tsx --exec node -r ts-node/register -r tsconfig-paths/register ./src/app.ts",
    "postinstall": "prisma generate"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts",
    "ignore": [
      "node_modules",
      "dist"
    ],
    "exec": "ts-node -r tsconfig-paths/register ./src/app.ts"
  },
  "dependencies": {
    "@prisma/client": "6.3.0",
    "@quixo3/prisma-session-store": "3.1.13",
    "dotenv": "16.4.7",
    "ejs": "3.1.10",
    "exact": "^1.0.1",
    "express": "^5.0.1",
    "express-session": "1.18.1",
    "mysql2": "3.12.0",
    "passport": "0.7.0",
    "passport-local": "1.0.0",
    "uuid": "11.0.5",
    "zod": "3.24.2",
    "bcrypt": "5.1.1",
    "multer": "1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/ejs": "3.1.5",
    "@types/express": "5.0.0",
    "@types/express-session": "1.18.1",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.7",
    "@types/passport": "1.0.17",
    "@types/passport-local": "1.0.38",
    "copyfiles": "^2.4.1",
    "nodemon": "3.1.9",
    "prisma": "6.3.0",
    "ts-node": "10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.7.3"
  }
}